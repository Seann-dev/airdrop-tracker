# Environment configuration for AIRDROP TRACKER AI

# Database
DATABASE_URL=sqlite+aiosqlite:///./airdrop_tracker.db

# Security & JWT
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot & Mini App (Optional - App runs without Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=http://localhost:5173/app

# AI Extraction (Optional - Standard heuristic parser runs without AI)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Localization & Monitoring
DEFAULT_TIMEZONE=Asia/Jakarta
MONITOR_CHECK_INTERVAL_MINUTES=60
